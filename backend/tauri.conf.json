{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wendy Widget Framework",
  "identifier": "com.cyan.wendy",
  "build": {
    "beforeDevCommand": "pnpm vite:dev",
    "beforeBuildCommand": "pnpm vite:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Wendy Widget Framework",
        "label": "main",
        "decorations": false,
        "resizable": false,
        "visible": false,
        "center": true,
        "width": 1600,
        "height": 1000
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": [
        "script-src"
      ],
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self' 'unsafe-inline' asset: http://asset.localhost https://asset.localhost blob:",
        "style-src": "'self' 'unsafe-inline' asset: http://asset.localhost https://asset.localhost",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost blob: data:",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob: data:",
        "font-src": "'self' asset: http://asset.localhost https://asset.localhost data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost",
        "frame-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "category": "Utility",
    "copyright": "Copyright © 2026 Cyan Froste",
    "shortDescription": "A widget framework for Windows and HTML programmers",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}